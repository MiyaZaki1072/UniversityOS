# PostgreSQL
POSTGRES_DB=uos
POSTGRES_USER=uos
POSTGRES_PASSWORD=uos
DATABASE_URL=postgres://uos:uos@db:5432/uos

# Django
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-random-50-plus-character-secret-key
DJANGO_DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
ADMIN_URL=admin/

# Web / Nginx
WEB_PORT=8080

# Production TLS / Cookie Security (set to true when behind an HTTPS reverse proxy)
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
