# Copy this file to .env and fill in the two secrets.
# Make each secret with:  openssl rand -hex 32
# (Use letters and digits only for POSTGRES_PASSWORD; it goes inside a URL.)

# PostgreSQL
POSTGRES_DB=uos
POSTGRES_USER=uos
POSTGRES_PASSWORD=change-me-to-a-long-random-hex-string
# Built from the values above inside docker-compose.yml; only set it when running Django outside Docker.
DATABASE_URL=postgres://uos:change-me@localhost:5432/uos

# Django
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=change-me-to-a-different-long-random-hex-string
DJANGO_DEBUG=false
# Which host names may open the app. "*" is fine on a home network / VPN;
# otherwise list them, e.g. 192.168.1.50,zimaos.local,zimaos.tail1234.ts.net
ALLOWED_HOSTS=*
# Only needed when the app is opened through an HTTPS proxy on another port, e.g. https://zimaos.tail1234.ts.net
CSRF_TRUSTED_ORIGINS=
# Admin pages live at http://<server>:<WEB_PORT>/<ADMIN_URL>
ADMIN_URL=manage/

# Web
WEB_PORT=8080

# Backups (one gzip'd database dump per day)
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# HTTPS — leave false on plain http://<lan-ip>:8080. Set the first three to true
# only when every visit goes through HTTPS (e.g. Tailscale Serve or a reverse proxy).
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
